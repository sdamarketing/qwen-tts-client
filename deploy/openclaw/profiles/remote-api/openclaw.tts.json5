{
  // Merge this fragment into ~/.openclaw/openclaw.json
  messages: {
    tts: {
      enabled: true,
      provider: "tts-local-cli",
      audioAsVoice: true,
      textLimit: 500,
      providers: {
        "tts-local-cli": {
          enabled: true,
          command: "/home/alekhm/.openclaw/bin/qwen_tts_proxy_opus.sh",
          args: ["{{Text}}", "{{OutputPath}}"],
          outputFormat: "opus",
          timeoutMs: 120000
        }
      }
    }
  }
}
